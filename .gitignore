
# ============================================================
# AI Practitioner Journey — .gitignore
# ============================================================

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
secrets/
credentials.json

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Local databases
*.db
*.sqlite
*.sqlite3

# Coverage and test reports
.coverage
.coverage.*
htmlcov/
coverage.xml
test-results/

# Local model weights and large artifacts
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/
checkpoints/

# Generated experiment outputs
# Keep curated, reviewed results in GitHub.
results/raw/
results/temp/
**/results/raw/
**/results/temp/

# Docker local overrides
docker-compose.override.yml
compose.override.yaml

# Local application uploads and storage
uploads/
local-data/

# Python packaging
pip-wheel-metadata/
*.whl

# Local scratch files
scratch/
sandbox/
